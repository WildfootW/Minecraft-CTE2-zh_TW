	quest_links: [ ]
	quests: [
		{
			description: [
				"&eLightman's Currency&r 引進了硬幣作為貨幣、各種交易站、拍賣行等等。 "
				""
				"你放置的任何 &eLightman's Trader&r（交易員）只有你或你的 Lightman's &e隊伍&r 才能修改。點擊物品欄右上角的小史蒂夫圖示即可建立隊伍帳號。介面上也有一個 &e通知&r 按鈕，用來顯示交易員與隊伍帳號的相關事件。隊伍帳號可用來在玩家之間共享利潤與成本。"
				""
				"&e貨幣&r 可透過 &e擊殺&r 怪物、&e戰利品&r 以及 &e任務&r 取得。"
				""
				"使用 &e/lctrade&r 指令可以和附近的其他玩家交易。"
			]
			id: "06B577BB603F2F0A"
			rewards: [{
				auto: "enabled"
				command: "/mine_and_slash give xp_times_lvl @p 100"
				elevate_perms: true
				icon: "ftb_ph:exp"
				id: "374773DC08579C0F"
				silent: true
				title: "100 經驗值 x 等級"
				type: "command"
			}]
			subtitle: "合成一台自動販賣機（Vending Machine）"
			tasks: [{
				id: "3A6E6453C16F4C89"
				item: "lightmanscurrency:vending_machine"
				type: "item"
			}]
			title: "Lightman's Currency"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["06B577BB603F2F0A"]
			description: [
				"大部分的物品交易員方塊可以交易任何物品，但像 &e書&r 或 &e盔甲&r 這類特定物品類型，需要專門的 &e交易員&r。 "
				""
				"使用 &e收銀機（Cash Register）&r 右鍵點擊任何已放置的交易員即可 &e連結&r 並 &e綁定&r 到該 &e收銀機&r。收銀機放置後，交易員內所有可交易的項目都會 &e顯示&r 在 &e收銀機介面&r 中。"
			]
			id: "64C7494796410D04"
			rewards: [{
				auto: "enabled"
				command: "/mine_and_slash give xp_times_lvl @p 100"
				elevate_perms: true
